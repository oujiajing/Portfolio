---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="区家敬｜AI 产品经理作品集"
  description="区家敬的 AI 产品经理作品集。展示 SafeGuard Agent、SafeFlow 和 Invoice Assistant 的产品设计与可运行实现。"
>
  <div id="top"></div>
  <Header />
  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> 2027届秋招 · 产品经理</p>
        <p class="hero-greeting">你好，我是</p>
        <h1 id="hero-title">区家敬<span class="hero-role">AI 产品经理</span></h1>
        <p class="hero-intro">我从真实业务场景出发，梳理用户问题与关键流程，判断 AI 能在哪一步创造价值；再将模型能力设计成可用、可控、可验证的产品体验。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">查看精选项目 <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="https://github.com/oujiajing" target="_blank" rel="noopener noreferrer">访问 GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="strengths" aria-label="我的工作方式">
        <article>
          <span class="strength-number">01 / 用户洞察</span>
          <h2>从业务流程与用户任务中识别真实需求</h2>
        </article>
        <article>
          <span class="strength-number">02 / 落地推进</span>
          <h2>从产品判断走到可运行的方案</h2>
        </article>
        <article>
          <span class="strength-number">03 / 敏捷迭代</span>
          <h2>根据测试与反馈持续优化产品</h2>
        </article>
      </div>
    </section>

    <section class="projects-section shell" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><p class="section-index">01 / SELECTED WORK</p><h2 id="projects-title">精选项目</h2></div>
      </div>
      <div class="project-list">
        {projects.map((project, index) => (
          <article class:list={['project-row', { 'project-row--reverse': index % 2 === 1 }]}>
            <button class="project-media" type="button" data-project-open={project.slug} aria-label={`查看 ${project.subtitle} 案例`}>
              <img src={project.cover} alt={project.coverAlt} loading="lazy" />
            </button>
            <div class="project-copy">
              <p class="project-kicker"><span>{project.number}</span> {project.category}</p>
              <h3>{project.subtitle}</h3>
              <p class="project-summary">{project.summary}</p>
              <ul class="tag-list" aria-label="项目关键词">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <button class="text-link" type="button" data-project-open={project.slug}>查看案例 <span aria-hidden="true">↗</span></button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="shell about-shell">
        <p class="section-index">02 / ABOUT ME · 关于我</p>
        <div class="about-grid">
          <div class="about-copy">
            <h2 id="about-title">有热情，敢创造，<br />也能把想法真正做出来<span>。</span></h2>
            <p>我喜欢追问问题为什么发生，也会把新知识放进原型、评测和真实体验里验证。</p>
          </div>
          <div class="about-traits">
            <article class="about-trait">
              <span>01</span>
              <div><h3>喜欢思考，也保持好奇</h3><p>不满足于现成答案，习惯继续追问问题为什么发生、现有方案为什么不够好，以及 AI 能否带来新的产品形态。</p></div>
            </article>
            <article class="about-trait">
              <span>02</span>
              <div><h3>学得快，也用得起来</h3><p>持续关注最新论文、模型与技术方案，并通过原型、评测和实际体验判断价值，让新知识真正被产品用起来。</p></div>
            </article>
            <article class="about-trait">
              <span>03</span>
              <div><h3>有创造力，也有执行力</h3><p>从产品构思、机制设计到开发落地，能快速推进完整闭环；在 SafeGuard Agent 等项目中，把想法搭建成可运行的产品。</p></div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section shell" id="contact" aria-labelledby="contact-title">
      <div><p class="section-index">03 / CONTACT</p><h2 id="contact-title">期待交流</h2></div>
      <div class="contact-copy">
        <p>懂用户，知 AI 边界，重产品落地，欢迎联系。</p>
        <div class="contact-links">
          <a href="mailto:oujiajing1103@163.com">oujiajing1103@163.com <span aria-hidden="true">↗</span></a>
          <a href="tel:+8613169363116">131 6936 3116 <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/oujiajing" target="_blank" rel="noopener noreferrer">GitHub / oujiajing <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <ProjectDialog />
  <Footer />
</BaseLayout>
